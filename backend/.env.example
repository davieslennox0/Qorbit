PORT=3001

# Arc testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://testnet.arcscan.app

# Test wallet private key (funded via https://faucet.circle.com - select Arc Testnet)
# NEVER commit a real key. This is for local testnet use only.
ARC_TEST_WALLET_PRIVATE_KEY=

# Deployed contracts (Arc testnet) - see contracts/deployments/arc-testnet.json
REGISTRY_ADDRESS=
ROUTER_ADDRESS=
DILITHIUM_VERIFIER_ADDRESS=

# ERC-8004 platform identity (set these after deploying and registering the platform agent)
# PLATFORM_AGENT_ID is the bytes32 agentId returned by QorbitpayRegistry.registerAgent()
PLATFORM_AGENT_ID=
PLATFORM_OWNER_ADDRESS=
SERVICE_ENDPOINT=https://qorbitpay.duckdns.org

# Quantum services bridge (../quantum-services) - VQC fraud detection + QAOA routing
QUANTUM_PYTHON_PATH=../quantum-services/.venv/bin/python3
QUANTUM_SCRIPTS_DIR=../quantum-services/quantum

# Threshold above which payments get an on-chain Dilithium attestation (native token units)
PQ_ATTESTATION_THRESHOLD=0.10

# Recurring billing contract
BILLING_ADDRESS=

# Delegated treasury contract
TREASURY_ADDRESS=
